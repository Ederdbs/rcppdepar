## Hey Emacs make this a -*- mode: makefile; -*- file
##
## -- default
PKG_LIBS=$(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
##
## -- also set ARMA_USE_CURRENT to enable current Armadillo
## -- RcppParallel is used with its TinyThread backend (see
## -- RCPP_PARALLEL_USE_TBB in src/devol.cpp), which is header-only,
## -- so no extra RcppParallel link flags are needed here
## -- no $(SHLIB_OPENMP_CXXFLAGS): there is no #pragma omp anywhere in src/
PKG_CXXFLAGS=-DARMA_USE_CURRENT
